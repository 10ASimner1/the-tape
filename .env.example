# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
#   cp .env.example .env.local
#
# npm scripts load it automatically via --env-file-if-exists, so nothing needs
# exporting by hand. In CI these become GitHub Actions secrets instead — the file
# itself never leaves your machine.

# ─── Required for every command ──────────────────────────────────────────────
# Salt for maintainer email hashes. Generate ONCE with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never change it after the archive has data: every hash would stop joining to
# the ones already recorded. Keep an offline copy — losing it is unrecoverable.
TAPE_PII_SALT=

# ─── Blob store (M2). Leave blank to keep using the local filesystem store. ───
# From the Backblaze bucket page and the application key you created.
# `keyName` is only a label in the B2 console — it goes nowhere.
TAPE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
TAPE_S3_REGION=us-west-004
TAPE_S3_BUCKET=
TAPE_S3_KEY_ID=
TAPE_S3_SECRET=

# ─── Politeness ──────────────────────────────────────────────────────────────
# These go in the User-Agent on every request. npm reserves the right to ban by
# user-agent, so being reachable is the difference between an email and a ban.
# Use the project alias, never a personal address.
TAPE_REPO_URL=https://github.com/<you>/the-tape
TAPE_CONTACT=

# ─── Liveness (M2) ───────────────────────────────────────────────────────────
# healthchecks.io ping URL. The only thing that tells you the tape stopped —
# GitHub disables scheduled workflows after 60 days with no email and no log entry.
TAPE_HEALTHCHECK_URL=

# ─── Local only ──────────────────────────────────────────────────────────────
# Where the filesystem store writes during development.
TAPE_STORE_DIR=.tape-store
