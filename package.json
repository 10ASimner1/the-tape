{
  "name": "the-tape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An always-on recorder of npm publish, update and unpublish events.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "bootstrap": "node --env-file-if-exists=.env.local src/main.ts bootstrap",
    "record": "node --env-file-if-exists=.env.local src/main.ts record",
    "recover-cursor": "node --env-file-if-exists=.env.local src/main.ts recover-cursor",
    "store-check": "node --env-file-if-exists=.env.local src/main.ts store-check"
  },
  "//": "dependencies is intentionally empty. This is a supply-chain-security project; the recorder runs on Node built-ins alone, so there is no lockfile attack surface to be the story about.",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
