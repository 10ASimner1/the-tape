node_modules/
.env
.env.*
!.env.example

# Local blob store used by store.fs.ts during development (M1).
# Never commit archive payload to git — the repo holds metadata only.
.tape-store/
*.local.json

# The SQLite index is a DERIVED artifact, rebuildable from raw at any time.
# Committing it would put a multi-hundred-MB binary in a repo whose whole point
# is that the index is disposable.
.tape-index.sqlite
*.sqlite-journal

# Transient staging dir used when piping secrets into `gh secret set`. Deleted
# immediately, but ignored in case a run is interrupted mid-way.
.secrets-stage/

# Secrets live in .env.local (covered by .env.* above) and in GitHub Actions
# secrets. Nowhere else — not in code, not in config, not in a commit message.
# If the PII salt leaks, every maintainer hash in the archive becomes a
# reversible email address.

